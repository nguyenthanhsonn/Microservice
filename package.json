{
  "name": "cinepro",
  "version": "0.1.0",
  "private": true,
  "description": "CinePro NestJS microservices backend",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api-gateway && nest build auth-user-service && nest build movie-service && nest build cinema-showtime-service && nest build booking-service && nest build payment-service && nest build ticket-service && nest build notification-service && nest build product-service",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-user-service --watch",
    "start:auth-user": "nest start auth-user-service --watch",
    "start:movie": "nest start movie-service --watch",
    "start:cinema": "nest start cinema-showtime-service --watch",
    "start:cinema-showtime": "nest start cinema-showtime-service --watch",
    "start:booking": "nest start booking-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:ticket": "nest start ticket-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:product": "nest start product-service --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d libs/database/src/typeorm.config.ts",
    "migration:run": "npm run typeorm -- migration:run -d libs/database/src/typeorm.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d libs/database/src/typeorm.config.ts",
    "migration:show": "npm run typeorm -- migration:show -d libs/database/src/typeorm.config.ts",
    "schema:sync": "npm run typeorm -- schema:sync -d libs/database/src/typeorm.config.ts",
    "schema:log": "npm run typeorm -- schema:log -d libs/database/src/typeorm.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "joi": "^17.13.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
